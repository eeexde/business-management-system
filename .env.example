# Local SQLite file (default). For Turso use libsql://<db>.turso.io and set DATABASE_AUTH_TOKEN.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Public demo: lock account/team/settings changes so visitors can't lock each other out.
DEMO_MODE=false
