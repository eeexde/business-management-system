# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database
/local.db*
/test-results/
/playwright-report/
!.env.example
/.claude/settings.local.json
/e2e.db*
/scratch-*.db*
/qa.db*
/review-scratch.db*
/ci.db*

# any SQLite database file
*.db
*.db-journal
*.db-wal
*.db-shm
